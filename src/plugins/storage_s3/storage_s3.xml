<?xml version="1.0" encoding="utf-8"?>
<extension version="1.0" type="plugin" group="mymuse">
	<name>plg_mymuse_storage_s3</name>
	<author>Arboreta</author>
	<creationDate>July 2023</creationDate>
	<copyright>Copyright (C) 2023 Arboreta Internet Services. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<authorEmail>info@arboreta.ca</authorEmail>
	<authorUrl>www.arboreta.ca</authorUrl>
	<version>5.0.1</version>
	<description>MYMUSE_ENABLE_S3_STORAGE</description>
	
	<files>
		<filename plugin="storage_s3">storage_s3.php</filename>
		<filename plugin="storage_s3">composer.json</filename>
		<filename plugin="storage_s3">composer.lock</filename>
		<filename plugin="storage_s3">cacert.pem</filename>
		<filename plugin="storage_s3">mymuseStorage.php</filename>
		<folder>vendor</folder>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/en-GB.plg_mymuse_storage_s3.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.plg_mymuse_storage_s3.sys.ini</language>
	</languages>

	<config>
	<fields  name="params">
		<fieldset name="basic">

        	<field 
        		name="my_s3web" 
        		type="text" 
        		default="" 
        		label="MYMUSE_CONFIG_S3_WEB_LABEL" 
        		description="MYMUSE_CONFIG_S3_WEB_DESC" 
        		size="100" 
        		filter="raw" 

        	/>
        	<field 
        		name="my_s3access" 
        		type="text" 
        		default="" 
        		label="MYMUSE_CONFIG_S3_ACCESSKEY_LABEL" 
        		description="MYMUSE_CONFIG_S3_ACCESSKEY_DESC" 
        		size="50" 
        		filter="raw" 

        	/>
			<field 
				name="my_s3secret" 
				type="password" 
				default="" 
				label="MYMUSE_CONFIG_S3_SECRETKEY_LABEL" 
				description="MYMUSE_CONFIG_S3_SECRETKEY_DESC" 
				size="50" 
				filter="raw" 
			/>
			<field 
        		name="my_s3region" 
        		type="text" 
        		default="" 
        		label="MYMUSE_CONFIG_S3_REGION_LABEL" 
        		description="MYMUSE_CONFIG_S3_REGION_DESC" 
        		size="50" 
        		filter="raw" 

        	/>
        	my_use_acceleration
        	<field 
				name="my_use_acceleration" 
				type="list" 
				default="0"
				label="MYMUSE_CONFIG_S3_ASCCELERATE_LABEL"
				description ="MYMUSE_CONFIG_S3_ASCCELERATE_DESC"
				>
				<option value="0">JYESE</option>
				<option value="0">JNO</option>

			</field>
			<field 
				name="my_s3perms" 
				type="list" 
				default="private"
				label="MYMUSE_CONFIG_S3_PERMS_LABEL"
				description ="MYMUSE_CONFIG_S3_PERMS_DESC"
				>
				<option value="private">MYMUSE_CONFIG_S3_PERMS_PRIVATE</option>
				<option value="public-read">MYMUSE_CONFIG_S3_PERMS_PUBLIC_READ</option>
				<option value="public-read-write">MYMUSE_CONFIG_S3_PERMS_PUBLIC_READ_WRITE</option>
				<option value="authenticated-read">MYMUSE_CONFIG_S3_PERMS_ACL_AUTHENTICATED_READ</option>
				<option value="bucket-owner-read">MYMUSE_CONFIG_S3_PERMS_ACL_BUCKET_OWNER_READ</option>
				<option value="bucket-owner-full-control">MYMUSE_CONFIG_S3_PERMS_ACL_BUCKET_OWNER_FULL_CONTROL</option>
			</field>
			<field 
				name="my_s3time" type="list" default="900"
				label="MYMUSE_CONFIG_S3_TIME_LABEL" desc="MYMUSE_CONFIG_S3_TIME_DESC"
				
				>
				<option value="60">MYMUSE_CONFIG_S3_TIME_1MINUTE</option>
				<option value="900">MYMUSE_CONFIG_S3_TIME_15MINUTES</option>
				<option value="3600">MYMUSE_CONFIG_S3_TIME_1HOUR</option>
				<option value="21600">MYMUSE_CONFIG_S3_TIME_6HOURS</option>
				<option value="43200">MYMUSE_CONFIG_S3_TIME_12HOURS</option>
				<option value="86400">MYMUSE_CONFIG_S3_TIME_1DAY</option>
				<option value="604800">MYMUSE_CONFIG_S3_TIME_7DAYS</option>
			</field>
        

		</fieldset>
	</fields>
	</config>
	
	
	
<updateservers>
    <server type="extension" priority="1"
        name="Plug MyMuse Storage S3">http://www.joomlamymuse.com/index.php?option=com_ars&amp;view=update&amp;task=stream&amp;format=xml&amp;id=81</server>
</updateservers>
</extension>
