<?xml version="1.0" encoding="utf-8"?>
<extension version="3.0" type="plugin" group="mymuse">
	<name>plg_mymuse_payment_paypal</name>
	<author>Arboreta</author>
	<creationDate>Jan 2023</creationDate>
	<copyright>Copyright (C) 2023 Arboreta Internet Services. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<authorEmail>info@arboreta.ca</authorEmail>
	<authorUrl>www.arboreta.ca</authorUrl>
	<version>5.0.0</version>
	<description>MYMUSE_BUILD_PAYPAL_PAYMENT_FORM</description>
	
	<files>
		<filename plugin="payment_paypal">payment_paypal.php</filename>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/plg_mymuse_payment_paypal.ini</language>
		<language tag="en-GB">language/en-GB/plg_mymuse_payment_paypal.sys.ini</language>
	</languages>

	<config>
	<fields  name="params">
		<fieldset name="basic">
		<field name="my_paypal_email" type="text" size="35" default=""
		label="MYMUSE_PAYPAL_EMAIL_LABEL" description="MYMUSE_PAYPAL_EMAIL_DESC"
		
		/>
		
        <field name="my_paypal_sandbox" type="radio" default="1" label="MYMUSE_PAYPAL_USE_SANDBOX_LABEL" description="MYMUSE_PAYPAL_USE_SANDBOX_DESC">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
        <field name="my_paypal_sandbox_email" type="text" size="35" default="sandtest2@gordfisch.net" label="MYMUSE_PAYPAL_SANDBOX_EMAIL_LABEL" description="MYMUSE_PAYPAL_SANDBOX_EMAIL_DESC"/>
        <field name="my_paypal_sandbox_customer_email" type="text" size="35" default="" label="MYMUSE_PAYPAL_SANDBOX_CUSTOMER_EMAIL_LABEL" description="MYMUSE_PAYPAL_SANDBOX_CUSTOMER_EMAIL_DESC"/>
        <field type="spacer" />
        <field name="my_use_image" 
        	type="radio" 
        	default="0" 
        	label="MYMUSE_PAYPAL_USE_IMAGE" 
        	description="MYMUSE_PAYPAL_USE_IMAGE_DESC">
		  <option value="0">JNO</option>
		  <option value="1">JYES</option>
		</field>
        <field type="spacer" />

			<field name="product_ids" 
				type="text" 
				default="" 
				label="MYMUSE_PRODUCT_IDS_LABEL" 
				description="MYMUSE_PRODUCT_IDS_DESC" />
        <field name="email_msg" 
        type="editor" 
        filter="raw" 
        rows="35" 
        cols="35" 
        default="" 
        label="MYMUSE_MSG_LABEL" 
        description="MYMUSE_MSG_DESC" />
        

		</fieldset>
	</fields>
	</config>
<updateservers>
    <server type="extension" priority="1"
        name="Plug MyMuse Payment PayPal">https://www.joomlamymuse.com/media/com_mymuse/mymuse-updates-payment_paypal.xml</server>
</updateservers>
</extension>
