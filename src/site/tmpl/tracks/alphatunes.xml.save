<?xml version="1.0" encoding="utf-8"?>
<metadata>
	<layout title="COM_MYMUSE_CATEGORY_VIEW_ALPHA_TUNES_TITLE" 
	option="COM_MYMUSE_CATEGORY_VIEW_ALPHA_TUNES_OPTION">
		<help
			key = "COM_MYMUSE_CATEGORY_VIEW_ALPHA_TUNES_OPTION"
		/>
		<message>
			<![CDATA[COM_MYMUSE_CATEGORY_VIEW_ALPHA_TUNES_DESC]]>
		</message>
	</layout>

	<!-- Add fields to the request variables for the layout. -->
	<fields name="request">
		<fieldset name="request"
		>

			<field name="id" type="category"
				description="JGLOBAL_CHOOSE_CATEGORY_DESC"
				extension="com_mymuse"
				label="JGLOBAL_CHOOSE_CATEGORY_LABEL"
				required="true"
			/>
		</fieldset>
	</fields>

	<!-- Add fields to the parameters object for the layout. -->
<fields name="params">
<fieldset name="basic" label="JGLOBAL_CATEGORY_OPTIONS">

		<field 
			name="show_subcategory_content" 
			type="list"
			description="COM_MYMUSE_SHOW_SUBCATEGORY_CONTENT_DESC"
			label="COM_MYMUSE_SHOW_SUBCATEGORY_CONTENT_LABEL"
		>	<option value="">JGLOBAL_USE_GLOBAL</option>
			<option value="0">JNONE</option>
			<option value="-1">JALL</option>
			<option value="1">J1</option>
			<option value="2">J2</option>
			<option value="3">J3</option>
			<option value="4">J4</option>
			<option value="5">J5</option>
		</field>
		
			<field name="show_category_title" type="list"
				label="JGLOBAL_SHOW_CATEGORY_TITLE"
				description="JGLOBAL_SHOW_CATEGORY_TITLE_DESC"
				useglobal="true"
				class="chzn-color"
			>
			
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>
			
			<field name="page_subheading" type="text"
				description="JGLOBAL_SUBHEADING_DESC"
				label="JGLOBAL_SUBHEADING_LABEL"
				size="20"
			/>

			<field name="show_description" type="list"
				description="JGLOBAL_SHOW_CATEGORY_DESCRIPTION_DESC"
				label="JGLOBAL_SHOW_CATEGORY_DESCRIPTION_LABEL"
				useglobal="true"
				class="chzn-color"
			>
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>

			<field name="show_description_image" 
				type="list"
				description="JGLOBAL_SHOW_CATEGORY_IMAGE_DESC"
				label="JGLOBAL_SHOW_CATEGORY_IMAGE_LABEL"
				useglobal="true"
				class="chzn-color"
			>

				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>
			
			<field name="category_image_height" type="text" default="0" 
	 			label="COM_MYMUSE_CATEGORY_IMAGE_HEIGHT" 
	 			description="COM_MYMUSE_CATEGORY_IMAGE_HEIGHT_DESC">
	 		</field>
	 		
	 		<field 
			name="category_match_level"
			type="list"
			default="product"
			label="COM_MYMUSE_CATEGORY_MATCH_LEVEL_LABEL"
			description="COM_MYMUSE_CATEGORY_MATCH_LEVEL_DESC"
			useglobal="true"
			class="chzn-color"
		>
			<option value="product">MYMUSE_CATEGORY_MATCH_PRODUCT</option>
			<option value="track">MYMUSE_CATEGORY_MATCH_TRACK</option>
		</field>

</fieldset>

