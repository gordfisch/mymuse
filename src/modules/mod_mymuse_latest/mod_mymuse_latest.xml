<?xml version="1.0" encoding="utf-8"?>
<extension version="3.0" type="module" client="site">
	<name>mod_mymuse_latest</name>
	<author>Arboreta</author>
	<creationDate>August 2023</creationDate>
	<copyright>Copyright (C) 2023 Arboreta Internet Services. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<authorEmail>info@arboreta.ca</authorEmail>
	<authorUrl>www.arboreta.ca</authorUrl>
	<version>5.0.0</version>
	<description>COM_MYMUSE_MOD_LATEST_DESC</description>
	<namespace path="src">Joomla\Module\MymuseLatest</namespace>
	<files>
		<filename module="mod_mymuse_latest">mod_mymuse_latest.php</filename>
        <filename module="mod_mymuse_latest">index.html</filename>
        <filename module="mod_mymuse_latest">mod_mymuse_latest_style.css</filename>
        <folder>tmpl</folder>
        <folder>assets</folder>
        <folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_mymuse_latest.ini</language>
		<language tag="en-GB">language/en-GB/mod_mymuse_latest.sys.ini</language>
	</languages>
	<config>
	<fields name="params">
		<fieldset name="basic">

		<field name="id" type="category"
			description="JGLOBAL_CHOOSE_CATEGORY_DESC"
			extension="com_mymuse"
			label="JGLOBAL_CHOOSE_CATEGORY_LABEL"
			required="true"
		/>

		<field name="product_ids" 
			type="textarea" 
			default="" 
			rows="10" cols="5" 
			label="COM_MYMUSE_PRODUCT_IDS" 
			description="COM_MYMUSE_PRODUCT_IDS_DESC" />
		
	   	<field
			name="blog_class"
			type="text"
			label="COM_MYMUSE_BLOG_CLASS"
			validate="CssIdentifier"
			>
		</field>
		<field 
			name="num_columns"
			type="text"
			label="COM_MYMUSE_NUM_COLUMNS_LABEL"
			filter="integer"
			Default="4"
			>
		</field>

		<field
			name="multi_column_order"
			type="list"
			label="JGLOBAL_MULTI_COLUMN_ORDER_LABEL"
			validate="options"
			default="1"
			>
			<option value="0">JGLOBAL_BLOG_DOWN_OPTION</option>
			<option value="1">JGLOBAL_BLOG_ACROSS_OPTION</option>
		</field>

		<field 
			name="orderby_pri"
			type="list"
			label="JGLOBAL_CATEGORY_ORDER_LABEL"
			useglobal="true"
			validate="options"
			parentclass="stack span-2"
			>
			<option value="none">JGLOBAL_NO_ORDER</option>
			<option value="alpha">JGLOBAL_TITLE_ALPHABETICAL</option>
			<option value="ralpha">JGLOBAL_TITLE_REVERSE_ALPHABETICAL</option>
			<option value="order">JGLOBAL_CATEGORY_MANAGER_ORDER</option>
		</field>

		<field 
			name="orderby_sec"
			type="list"
			label="COM_MYMUSE_PRODUCT_ORDER_LABEL"
			useglobal="true"
			validate="options"
			parentclass="stack span-2-inline"
			>
			<option value="rdate">JGLOBAL_MOST_RECENT_FIRST</option>
			<option value="date">JGLOBAL_OLDEST_FIRST</option>
			<option value="alpha">JGLOBAL_TITLE_ALPHABETICAL</option>
			<option value="ralpha">JGLOBAL_TITLE_REVERSE_ALPHABETICAL</option>
			<option value="author">JGLOBAL_AUTHOR_ALPHABETICAL</option>
			<option value="rauthor">JGLOBAL_AUTHOR_REVERSE_ALPHABETICAL</option>
			<option value="hits">JGLOBAL_MOST_HITS</option>
			<option value="rhits">JGLOBAL_LEAST_HITS</option>
			<option value="sales">COM_MYMUSE_MOST_SALES_ORDER</option>
			<option value="discount">COM_MYMUSE_MOST_DISCOUNT</option>
			<option value="rdiscount">COM_MYMUSE_LEAST_DISCOUNT</option>
			<option value="order">COM_MYMUSE_PRODUCT_MANAGER_ORDER</option>
		</field>

		<field 
			name="order_date"
			type="list"
			label="JGLOBAL_ORDERING_DATE_LABEL"
			useglobal="true"
			validate="options"
			parentclass="stack span-2-inline"
			>
			<option value="created">JGLOBAL_CREATED</option>
			<option value="modified">JGLOBAL_MODIFIED</option>
			<option value="published">JPUBLISHED</option>
			<option value="product_made_date">COM_MYMUSE_PRODUCT_CREATED_LABEL</option>
			<option value="product_release_date">COM_MYMUSE_DATE_PRODUCT_RELEASE_DATE</option>
				
		</field>
		

		<field 
			name="display_num" 
			type="list"
			label="COM_MYMUSE_NUMBER_ITEMS_LIST_LABEL"
			useglobal="true"
			parentclass="stack span-1"
			>
			<option value="5">J5</option>
			<option value="10">J10</option>
			<option value="15">J15</option>
			<option value="20">J20</option>
			<option value="25">J25</option>
			<option value="30">J30</option>
			<option value="50">J50</option>
			<option value="100">J100</option>
			<option value="0">JALL</option>
		</field>

                
	</fieldset>
	<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC" />

				<field
					name="moduleclass_sfx"
					type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />

				<field
					name="cache"
					type="list"
					default="1"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC">
					<option
						value="1">JGLOBAL_USE_GLOBAL</option>
					<option
						value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>

				<field
					name="cache_time"
					type="text"
					default="900"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					description="COM_MODULES_FIELD_CACHE_TIME_DESC" />
				<field
					name="cachemode"
					type="hidden"
					default="static">
					<option
						value="static"></option>
				</field>
	</fieldset>
	</fields>
	</config>
</extension>
