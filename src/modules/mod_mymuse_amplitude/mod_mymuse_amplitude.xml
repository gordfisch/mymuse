<?xml version="1.0" encoding="utf-8"?>
<extension version="3.0" type="module" client="site">
	<name>MyMuse Module Amplitude</name>
	<author>Arboreta</author>
	<creationDate>Mar 2023</creationDate>
	<copyright>Copyright (C) 2023 Arboreta Internet Services. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<authorEmail>info@arboreta.ca</authorEmail>
	<authorUrl>www.arboreta.ca</authorUrl>
	<version>5.0.0</version>
	<description>COM_MYMUSE_MOD_AMPLITUDE_DESC</description>
	<files>
		<filename module="mod_mymuse_amplitude">mod_mymuse_amplitude.php</filename>
        <filename module="mod_mymuse_amplitude">index.html</filename>
        <filename module="mod_mymuse_amplitude">helper.php</filename>
        <folder>tmpl</folder>
		<folder>assets</folder>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/mod_mymuse_amplitude.ini</language>
		<language tag="en-GB">language/en-GB/mod_mymuse_amplitude.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset
				name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					 />
				<field
					name="moduleclass_sfx"
					type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					/>
				<field
					name="cache"
					type="list"
					default="0"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC">
					<option
						value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
			</fieldset>
		</fields>
	</config>
<updateservers>
    <server type="extension" priority="1"
        name="Mod MyMuse Amplitude">https://www.joomlamymuse.com/media/com_mymuse/mymuse-updates-mod_mymuse_amplitude.xml</server>
</updateservers>
</extension>

