<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\Mymuse\Administrator\Field">
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_MYMUSE_FORMAT_FILTER_SEARCH_LABEL"
			description="COM_MYMUSE_FORMAT_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>



	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			onchange="this.form.submit();"
			default="a.currency_name ASC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.format_key ASC">COM_MYMUSE_FORMAT_KEY_ASC</option>
			<option value="a.format_key DESC">COM_MYMUSE_FORMAT_KEY_DESC</option>
			<option value="a.format_value ASC">COM_MYMUSE_FORMAT_VALUE_ASC</option>
			<option value="a.format_value DESC">COM_MYMUSE_FORMAT_VALUE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
