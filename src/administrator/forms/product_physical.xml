
<?xml version="1.0" encoding="utf-8"?>
<fieldset name="dimensions" label="COM_MYMUSE_DIMENSIONS">

  <field 
    name="product_images" 
    type="folderlist" 
    default="" 
    label="COM_MYMUSE_PRODUCT_IMAGES" 
    description="COM_MYMUSE_PRODUCT_IMAGES_DESC"
    directory="images" 
    filter="" 
    exclude="" 
    stripext="" 
    recursive="true"
  />
  <field 
    name="product_weight" 
    type="text"
    label="COM_MYMUSE_PRODUCT_WEIGHT_LABEL" 
    description="COM_MYMUSE_PRODUCT_WEIGHT_DESC"
    size="20" />
  <field 
    name="product_weight_uom" 
    type="list"
    label="COM_MYMUSE_PRODUCT_WEIGHT_UOM_LABEL" 
    description="COM_MYMUSE_PRODUCT_WEIGHT_UOM_DESC"
    >
    <option value="LBS">MYMUSE_PRODUCT_WEIGHT_LBS_LABEL</option>
    <option value="KGS">MYMUSE_PRODUCT_WEIGHT_KGS_LABEL</option>
    <option value="G">MYMUSE_PRODUCT_WEIGHT_G_LABEL</option>
  </field>

  <field 
    name="product_length" 
    type="text"
    label="COM_MYMUSE_PRODUCT_LENGTH_LABEL" 
    description="COM_MYMUSE_PRODUCT_LENGTH_DESC"
    />
  <field 
    name="product_width" 
    type="text"
    label="COM_MYMUSE_PRODUCT_WIDTH_LABEL" 
    description="COM_MYMUSE_PRODUCT_WIDTH_DESC"
    />
  <field 
    name="product_height" 
    type="text"
    label="COM_MYMUSE_PRODUCT_HEIGHT_LABEL" 
    description="COM_MYMUSE_PRODUCT_HEIGHT_DESC"
    />
  <field 
    name="product_lwh_uom" 
    type="list"
    label="COM_MYMUSE_PRODUCT_LWH_UOM_LABEL" 
    description="COM_MYMUSE_PRODUCT_LWH_UOM_DESC"
    >
    <option value="IN">MYMUSE_PRODUCT_LWH_IN_LABEL</option>
    <option value="FT">MYMUSE_PRODUCT_LWH_FT_LABEL</option>
    <option value="M">MYMUSE_PRODUCT_LWH_M_LABEL</option>
    <option value="CM">MYMUSE_PRODUCT_LWH_CM_LABEL</option>
  </field>
</fieldset>