<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset>
    <field
      name="metadesc"
      type="textarea"
      label="JFIELD_META_DESCRIPTION_LABEL"
      description="JFIELD_META_DESCRIPTION_DESC"
      rows="3"
      cols="40"
    />

    <field
      name="metakey"
      type="textarea"
      label="JFIELD_META_KEYWORDS_LABEL"
      description="JFIELD_META_KEYWORDS_DESC"
      rows="3"
      cols="40"
    />
    <field 
  		name="product_release_date"
  		type="calendar" 
  		label="COM_MYMUSE_PRODUCT_RELEASE_DATE_LABEL"
  		description="COM_MYMUSE_PRODUCT_RELEASE_DATE_DESC"
  		class="inputbox" size="22"
  		format="%Y-%m-%d" 
  		filter="none" 
  	/>
		
    <field
      name="product_full_time"
      type="text"
      label="COM_MYMUSE_PRODUCT_FULL_TIME_LABEL"
      description="COM_MYMUSE_PRODUCT_FULL_TIME_DESC"
      class="inputbox"
      size="20"
      required="false"
      />
	
      <field
      name="product_country"
      type="country"
      label="COM_MYMUSE_PRODUCT_COUNTRY_LABEL"
      description="COM_MYMUSE_PRODUCT_COUNTRY_DESC"
      class="inputbox"
      size="1"
      />
	
    <field
      name="product_publisher"
      type="text"
      label="COM_MYMUSE_PRODUCT_PUBLISHER_LABEL"
      description="COM_MYMUSE_PRODUCT_PUBLISHER_DESC"
      class="inputbox"
      size="35"
      required="false"
    />
	
    <field
      name="product_producer"
      type="text"
      label="COM_MYMUSE_PRODUCT_PRODUCER_LABEL"
      description="COM_MYMUSE_PRODUCT_PRODUCER_DESC"
      class="inputbox"
      size="35"
      required="false"
    />
	
    <field
      name="product_studio"
      type="text"
      label="COM_MYMUSE_PRODUCT_STUDIO_LABEL"
      description="COM_MYMUSE_PRODUCT_STUDIO_DESC"
      class="inputbox"
      size="35"
      required="false"
    />

    <field 
      name="product_coming_soon" 
      type="list"
      label="COM_MYMUSE_PRODUCT_COMING_SOON_LABEL"
      description="COM_MYMUSE_PRODUCT_COMING_SOON_DESC"
      default="0"
      >
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>      

    <field 
      name="product_preorder" 
      type="list"
      label="COM_MYMUSE_PRODUCT_PREORDER_LABEL"
      description="COM_MYMUSE_PRODUCT_PREORDER_DESC"
      default="0"
      >
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>

    <field 
      name="special_status" 
      type="list"
      label="COM_MYMUSE_PRODUCT_SPECIAL_STATUS_LABEL"
      description="COM_MYMUSE_PRODUCT_SPECIAL_STATUS_DESC"
      default="0"
      >
      <option value="">None</option>
      <option value="COM_MYMUSE_COMING_SOON">MYMUSE_COMING_SOON</option>
      <option value="COM_MYMUSE_PREORDER">MYMUSE_PREORDER</option>
      <option value="COM_MYMUSE_OUT_OF_STOCK">MYMUSE_OUT_OF_STOCK</option>
      <option value="COM_MYMUSE_NO_LONGER_AVAILABLE">MYMUSE_NO_LONGER_AVAILABLE</option>
    </field>
    
		<field
      name="media_rls"
      type="hidden"
      label="COM_MYMUSE_NEWS_RLS_LABEL"
      description="COM_MYMUSE_NEWS_RLS_DESC"
      class="inputbox"
			edit="true"
			clear="true"
      required="false"
    />
    <field
      name="media_link"
      type="hidden"
      label="COM_MYMUSE_MEDIA_LINK_LABEL"
      description="COM_MYMUSE_MEDIA_LINK_DESC"
      class="inputbox"
			directory="/"
      required="false"
    />
  </fieldset>

  <fields name="metadata">
    <fieldset name="metadata" label="COM_MYMUSE_PARAMETERS_METADATA">

    <field name="robots"
      type="list"
      label="JFIELD_METADATA_ROBOTS_LABEL"
      description="JFIELD_METADATA_ROBOTS_DESC"
    >
      <option value="">JGLOBAL_USE_GLOBAL</option>
      <option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
      <option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
      <option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
      <option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
    </field>

    <field name="author" type="text"
      label="JAUTHOR" description="JFIELD_METADATA_AUTHOR_DESC"
      size="20" />

    <field name="rights" type="textarea" label="JFIELD_META_RIGHTS_LABEL"
      description="JFIELD_META_RIGHTS_DESC" required="false" filter="string"
      cols="30" rows="2" />
    <field name="xreference" type="text"
      label="COM_MYMUSE_FIELD_XREFERENCE_LABEL" description="COM_MYMUSE_FIELD_XREFERENCE_DESC"
      class="inputbox" size="20" />
    </fieldset>
  </fields>

