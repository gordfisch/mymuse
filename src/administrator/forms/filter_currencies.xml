<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\Mymuse\Administrator\Field">
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_MYMUSE_COUPONS_FILTER_SEARCH_LABEL"
			description="COM_MYMUSE_COUPONS_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>



	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			onchange="this.form.submit();"
			default="a.currency_name ASC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.currency_name ASC">COM_MYMUSE_CURRENCY_NAME_ASC</option>
			<option value="a.currency_name DESC">COM_MYMUSE_CURRENCY_NAME_DESC</option>
			<option value="a.currency_code ASC">COM_MYMUSE_CURRENCY_CODE_ASC</option>
			<option value="a.currency_code DESC">COM_MYMUSE_CURRENCY_CODE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
