<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\Mymuse\Administrator\Field">
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_MYMUSE_COUPONS_FILTER_SEARCH_LABEL"
			description="COM_MYMUSE_COUPONS_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="published"
			type="status"
			label="JSTATUS"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>http://localhost/mymuseJ4/joomla/administrator/index.php?option=com_categories&extension=com_mymuse
		</field>


	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			statuses="*,0,1,2,-2"
			onchange="this.form.submit();"
			default="a.tax_name ASC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.tax_name ASC">COM_MYMUSE_TAX_NAME_LABEL</option>
			<option value="a.tax_name DESC">COM_MYMUSE_TAX_NAME_DESCENDING</option>
			<option value="a.province ASC">COM_MYMUSE_TAX_PROVINCE_LABEL</option>
			<option value="a.province DESC">COM_MYMUSE_TAX_PROVINCE_DESCENDING</option>
			<option value="a.country ASC">COM_MYMUSE_TAX_COUNTRY_LABEL</option>
			<option value="a.country DESC">COM_MYMUSE_TAX_COUNTRY_DESCENDING</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
