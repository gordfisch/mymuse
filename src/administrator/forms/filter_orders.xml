<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\Mymuse\Administrator\Field">
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_MYMUSE_COUPONS_FILTER_SEARCH_LABEL"
			description="COM_MYMUSE_COUPONS_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field 
			name="startdate" 
			type="calendar" 
			default="" 
			label="COM_MYMUSE_STARTDATE" 
			description=""
			class="input-small" 
			required="true" 
			filter="user_utc"
			showtime="false" 
			todaybutton="false" 
			filltable="false" 
			translateformat="true" 
		/>
		<field 
			name="enddate" 
			type="calendar" 
			default="" 
			label="COM_MYMUSE_ENDDATE" 
			description=""
			class="input-small" 
			required="true" 
			filter="user_utc"
			showtime="false" 
			todaybutton="false" 
			filltable="false" 
			translateformat="true" 
		/>


	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			statuses="*,0,1,2,-2"
			onchange="this.form.submit();"
			default="a.tax_name ASC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="u.last_name ASC">COM_MYMUSE_NAME_ASC</option>
			<option value="u.last_name DESC">COM_MYMUSE_NAME_DESC</option>
			<option value="c.created ASC">COM_MYMUSE_DATE_ASC</option>
			<option value="c.created DESC">COM_MYMUSE_DATE_DESC</option>
			<option value="c.order_status ASC">COM_MYMUSE_STATUS_ASC</option>
			<option value="c.order_status DESC">COM_MYMUSE_STATUS_DESC</option>
			<option value="c.order_subtotal ASC">COM_MYMUSE_SUBTOTAL_ASC</option>
			<option value="c.order_subtotal DESC">COM_MYMUSE_SUBTOTAL_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
