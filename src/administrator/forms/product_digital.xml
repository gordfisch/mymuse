<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset>
    <field
      name="file_name"
      type="text"
      label="COM_MYMUSE_FILE_NAME_LABEL"
      description="COM_MYMUSE_FILE_NAME_DESC"
      class="inputbox"
      size="80"
      required="false"
    />
    <field 
      name="file_type" 
      type="list"
      label="COM_MYMUSE_PRODUCT_FILE_TYPE_LABEL"
      description="COM_MYMUSE_PRODUCT_FILE_TYPE_DESC"
      default="audio"
      >
      <option value="audio">MYMUSE_AUDIO</option>
      <option value="video">MYMUSE_VIDEO</option>
      <option value="other">MYMUSE_OTHER</option>
    </field>

    <field
      name="file_preview"
      type="text"
      label="MYMUSE_FILE_PREVIEW_LABEL"
      description="MYMUSE_PREVIEW_DESC"
      class="readonly"
      readonly="1"
      size="80"
      required="false"
    />
    
    <field
      name="file_length"
      type="text"
      label="COM_MYMUSE_FILE_LENGTH_LABEL"
      description="COM_MYMUSE_FILE_LENGTH_DESC"
      class="inputbox"
      size="20"
      required="false"
    />
    <field
      name="file_time"
      type="text"
      label="COM_MYMUSE_FILE_TIME_LABEL"
      description="COM_MYMUSE_FILE_TIME_DESC"
      class="inputbox"
      size="20"
      required="false"
    />
    <field
      name="file_ext"
      type="text"
      label="COM_MYMUSE_FILE_EXT_LABEL"
      description="COM_MYMUSE_FILE_EXT_DESC"
      class="inputbox"
      size="20"
      required="false"
    />
    <field
      name="file_downloads"
      type="text"
      label="COM_MYMUSE_FILE_DOWNLOADS_LABEL"
      description="COM_MYMUSE_FILE_DOWNLOADS_DESC"
      class="inputbox"
      size="20"
      required="false"
    />
    <field
      name="file_plays"
      type="text"
      label="COM_MYMUSE_FILE_PLAYS_LABEL"
      description="COM_MYMUSE_FILE_PLAYS_DESC"
      class="inputbox"
      size="20"
      required="false"
    />
    <field
      name="isrc_code"
      type="hidden"
      label="COM_MYMUSE_ISRC_LABEL"
      description="COM_MYMUSE_ISRC_DESC"
      class="inputbox"
      size="45"
      required="false"
    />
  </fieldset>
</form>