                <option value="1">JYES</option>
            </field>

            <field
                    name="file_time"
                    type="text"
                    label="COM_MYMUSE_FILE_TIME_LABEL"
                    description="COM_MYMUSE_FILE_TIME_DESC"
                    class="inputbox"
                    size="20"
                    required="false"
            />
