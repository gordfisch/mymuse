                    type="calendar"
                    label="COM_MYMUSE_PRODUCT_RELEASE_DATE_LABEL"
                    description="COM_MYMUSE_PRODUCT_RELEASE_DATE_DESC"
                    class="inputbox" size="22"
                    format="%Y-%m-%d"
                    filter="none"
            />
            
            <field
                    name="product_in_stock"
                    type="text"
                    label="COM_MYMUSE_PRODUCT_IN_STOCK_LABEL"
                    description="COM_MYMUSE_PRODUCT_IN_STOCK_DESC"
            />
            <field
                    name="file_type"
                    type="list"
                    label="COM_MYMUSE_PRODUCT_FILE_TYPE_LABEL"
                    description="COM_MYMUSE_PRODUCT_FILE_TYPE_DESC"
                    default="audio"
            >
                <option value="audio">COM_MYMUSE_AUDIO</option>
                <option value="video">COM_MYMUSE_VIDEO</option>
                <option value="other">COM_MYMUSE_OTHER</option>
            </field>
            <field
                    name="file_preview"
                    type="text"
                    label="COM_MYMUSE_FILE_PREVIEW_LABEL"
                    description="COM_MYMUSE_FILE_PREVIEW_DESC"
                    class="readonly"
                    readonly="1"
                    size="80"
                    required="false"
            />
            <field
                    name="isrc_code"
                    type="text"
                    label="COM_MYMUSE_ISRC_LABEL"
                    description="COM_MYMUSE_ISRC_DESC"
                    class="inputbox"
                    size="45"
                    required="false"
            />

            <field
                    name="metadesc"
                    type="textarea"
                    label="JFIELD_META_DESCRIPTION_LABEL"
                    description="JFIELD_META_DESCRIPTION_DESC"
                    rows="3"
                    cols="40"
            />

            <field
                    name="metakey"
                    type="textarea"
                    label="JFIELD_META_KEYWORDS_LABEL"
                    description="JFIELD_META_KEYWORDS_DESC"
                    rows="3"
                    cols="40"
            />
        </fieldset>

        <fieldset name="identity" label="COM_MYMUSE_PRODUCT_IDENTITY" addfieldprefix="Joomla\Component\Mymuse\Administrator\Field">

            <field
