<?xml version="1.0" encoding="utf-8"?>
<form>
        <fieldset addfieldprefix="Joomla\Component\Mymuse\Administrator\Field">
            <field
                    name="id"
                    type="number"
                    label="JGLOBAL_FIELD_ID_LABEL"
                    default="0"
                    class="readonly"
                    readonly="true"
            />
            <field
                    name="parentid"
                    type="text"
                    label="COM_MYMUSE_PARENT"
                    description="COM_MYMUSE_PARENT"
                    class="inputbox"
                    size="3"
                    required="false"
                    default="0"
            />
            <field
                    name="title"
                    type="text"
                    label="COM_MYMUSE_TITLE_LABEL"
                    description="COM_MYMUSE_TITLE_DESC"
                    class="inputbox"
                    size="45"
                    required="true"
            />
            <field
                    name="alias"
                    type="text"
                    label="COM_MYMUSE_ALIAS_LABEL"
                    description="COM_MYMUSE_ALIAS_DESC"
                    class="inputbox"
                    size="45"
            />

            <field
                    name="state"
                    type="list"
                    label="JSTATUS"
                    description="JFIELD_PUBLISHED_DESC"
                    class="inputbox"
                    size="1"
                    default="1">
                <option value="1">JPUBLISHED</option>
                <option value="0">JUNPUBLISHED</option>
            </field>

            <field
                    name="price"
                    type="text"
                    label="COM_MYMUSE_PRICE"
                    description="COM_MYMUSE_PRICE"
                    class="inputbox"
                    size="10"
                    required="false"
                    default="0.00"
            />
            <field
                    name="product_discount"
                    type="text"
                    label="COM_MYMUSE_DISCOUNT"
                    description="COM_MYMUSE_DISCOUNT"
                    class="inputbox"
                    size="10"
                    required="false"
                    default="0.00"
            />

            <field
                    name="product_downloadable"
                    type="list"
                    label="COM_MYMUSE_PRODUCT_DOWNLOADABLE_LABEL"
                    description="COM_MYMUSE_PRODUCT_DOWNLOADABLE_DESC"
                    default="0"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field
                    name="articletext"
                    type="editor"
                    class="inputbox"
                    label="COM_MYMUSE_STORE_DESC_LABEL"
                    description="COM_MYMUSE_STORE_DESC_DESC"
                    buttons="true"
                    filter="JComponentHelper::filterText"
            />
            <field
                    name="recommend"
                    type="producttree"
                    extension="com_mymuse"
                    label="COM_MYMUSE_PRODUCT_RECOMMEND_LABEL"
                    description="COM_MYMUSE_PRODUCT_RECOMMEND_DESC"
                    class="inputbox"
                    size="8"
                    required="false"
                    multiple="true"
            />
            <field
                    name="language"
                    type="contentlanguage"
                    label="JFIELD_LANGUAGE_LABEL"
                    description="JFIELD_LANGUAGE_DESC"
                    class="inputbox">
                <option value="*">JALL</option>
            </field>

            <field
                    name="list_image"
                    type="media"
                    label="COM_MYMUSE_LIST_IMAGE"
                    description="COM_MYMUSE_LIST_IMAGE_DESC"
                    directory=""
            />

            <field
                    name="detail_image"
                    type="media"
                    label="COM_MYMUSE_DETAIL_IMAGE"
                    description="COM_MYMUSE_DETAIL_IMAGE_DESC"
                    directory=""
            />

            <field
                    name="created"
                    type="calendar"
                    label="JGLOBAL_FIELD_CREATED_LABEL"
                    size="22"
                    translateformat="true"
                    showtime="true"
                    filter="user_utc"
            />

            <field
                    name="created_by"
                    type="user"
                    label="COM_MYMUSE_CREATED_BY_LABEL"
                    description="COM_MYMUSE_CREATED_BY_DESC"
            />

            <field name="created_by_alias"
                   type="text"
                   label="JGLOBAL_FIELD_CREATED_BY_ALIAS_LABEL"
                   description="JGLOBAL_FIELD_CREATED_BY_ALIAS_DESC"
                   class="inputbox"
                   size="20"
            />

            <field
                    name="modified"
                    type="calendar"
                    label="JGLOBAL_FIELD_MODIFIED_LABEL"
                    size="22"
                    translateformat="true"
                    showtime="true"
                    filter="user_utc"
            />

            <field
                    name="modified_by"
                    type="user"
                    label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
                    class="readonly"
                    readonly="true"
                    filter="unset"
            />

            <field name="checked_out" type="hidden" filter="unset"/>

            <field name="checked_out_time" type="hidden" filter="unset"/>

            <field
                    name="publish_up"
                    type="calendar"
                    label="COM_MYMUSE_PUBLISH_UP_LABEL"
                    translateformat="true"
                    showtime="true"
                    size="22"
                    filter="user_utc"
            />

            <field
                    name="publish_down"
                    type="calendar"
                    label="COM_MYMUSE_PUBLISH_DOWN_LABEL"
                    translateformat="true"
                    showtime="true"
                    size="22"
                    filter="user_utc"
            />
            <field
                    name="version"
                    type="text"
                    label="JVERSION"
                    class="readonly"
                    size="6"
                    readonly="true"
                    filter="unset"
            />

            <field
                    name="ordering"
                    type="text"
                    label="JFIELD_ORDERING_LABEL"
                    description="JFIELD_ORDERING_DESC"
                    class="inputbox"
                    size="6"
                    default="0"
            />


            <field
                    name="access"
                    type="accesslevel"
                    label="JFIELD_ACCESS_LABEL"
                    description="JFIELD_ACCESS_DESC"
                    class="inputbox"
                    size="1"
            />

            <field
                    name="hits"
                    type="text"
                    label="JGLOBAL_HITS"
                    description="COM_MYMUSE_HITS_DESC"
                    class="readonly"
                    size="6"
                    readonly="true"
                    filter="unset"
            />

            <field
                    name="featured"
                    type="list"
                    label="JFEATURED"
                    description="COM_MYMUSE_FEATURED"
                    default="0"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                    name="product_default"
                    type="list"
                    label="COM_MYMUSE_DEFAULT_LABEL"
                    description="COM_MYMUSE_DEFAULT_DESC"
                    default="0"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                    name="rules"
                    type="rules"
                    label="JFIELD_RULES_LABEL"
                    translate_label="false"
                    class="inputbox"
                    filter="rules"
                    component="com_content"
                    section="article"
                    validate="rules"
            />



            <field
                    name="product_coming_soon"
                    type="list"
                    label="COM_MYMUSE_PRODUCT_COMING_SOON_LABEL"
                    description="COM_MYMUSE_PRODUCT_COMING_SOON_DESC"
                    default="0"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                    name="product_preorder"
                    type="list"
                    label="COM_MYMUSE_PRODUCT_PREORDER_LABEL"
                    description="COM_MYMUSE_PRODUCT_PREORDER_DESC"
                    default="0"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                    name="special_status"
                    type="list"
                    label="COM_MYMUSE_PRODUCT_SPECIAL_STATUS_LABEL"
                    description="COM_MYMUSE_PRODUCT_SPECIAL_STATUS_DESC"
                    default="0"
            >
                <option value="0">None</option>
                <option value="COM_MYMUSE_COMING_SOON">COM_MYMUSE_COMING_SOON</option>
                <option value="COM_MYMUSE_PREORDER">COM_MYMUSE_PREORDER</option>
                <option value="COM_MYMUSE_OUT_OF_STOCK">COM_MYMUSE_OUT_OF_STOCK</option>
                <option value="COM_MYMUSE_NO_LONGER_AVAILABLE">COM_MYMUSE_NO_LONGER_AVAILABLE</option>
            </field>

            <field
