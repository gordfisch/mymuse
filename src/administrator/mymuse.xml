<?xml version="1.0" encoding="utf-8" ?>
<extension type="component" method="upgrade">

	<name>COM_MYMUSE</name>
	<creationDate>July 2020</creationDate>
	<copyright>Copyright (C) 2020. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <author>Arboreta</author>
	<authorEmail>gord@arboreta.ca</authorEmail>
	<authorUrl>http://www.joomlamymuse.com</authorUrl>
	<version>5.0.1</version>

	<description>COM_MYMUSE_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Component\Mymuse</namespace>
	<scriptfile>script.php</scriptfile>
	
	<install> <!-- Runs on install -->
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall> <!-- Runs on uninstall -->
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
    

    <!-- Frond-end files -->
	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="site">
			<language tag="en-GB">language/en-GB/en-GB.com_mymuse.ini</language>
	</languages>

	<!-- Back-end files --> 
	<administration>
		<menu view="mymuse">COM_MYMUSE</menu>
		<submenu>
			<menu link="option=com_mymuse">COM_MYMUSE</menu>
			<menu link="option=com_mymuse&amp;view=store&amp;task=store.edit&amp;id=1" view="store" 
				alt="Mymuse/Store">COM_MYMUSE_STORE</menu>
			<menu link="option=com_mymuse&amp;view=taxrates" view="taxrates" 
				alt="Mymuse/Taxrates">COM_MYMUSE_TAXRATES</menu>
			<menu link="option=com_mymuse&amp;view=shoppergroups" view="shoppergroups" 
				alt="Mymuse/Shoppergroups">COM_MYMUSE_SHOPPERGROUPS</menu>
		</submenu>
		<files folder="administrator">
			<filename>mymuse.xml</filename>
			<filename>config.xml</filename>
			<filename>access.xml</filename>
			<folder>forms</folder>
			<folder>install</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="administrator">
			<language tag="en-GB">language/en-GB/en-GB.com_mymuse.ini</language>
			<language tag="en-GB">language/en-GB/en-GB.com_mymuse.sys.ini</language>
		</languages>
	</administration>  
	
   <files folder="site">
   	<filename>log.txt</filename>
   	<folder>assets</folder>
   	<folder>src</folder>
   	<folder>tmpl</folder>
   	
   </files>
    <!-- Runs on install/uninstall/update -->
	
	<!-- Plugins -->
	<plugins>
	</plugins>
	<!-- Modules -->
	<modules>
	</modules>


	<changelogurl>http://localhost/mymuseJ4/joomla/changelog.xml</changelogurl>

	<updateservers>
        <server type="extension" name="My Extension's Updates">http://localhost/mymuseJ4/joomla/mymuse-updates.xml</server>
	</updateservers>
	<dlid prefix="dlid=" suffix="" />
</extension>

