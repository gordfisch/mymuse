#/bin/bash


if  [[ $1 = "webdriver" ]]; then
    echo "Starting webdriver"
    cd joomla-cms
    ./node_modules/.bin/selenium-standalone start &
elif  [[ $1 = "phing" ]]; then
	if  [[ $2 = "watch" ]]; then
		echo "Doing the phing thing. Will watch your dir for changes"
	    cd src
	    ./rerun ../vendor/phing/phing/bin/phing
	else
    	echo "Doing the phing thing."
    	cd src
    	../vendor/phing/phing/bin/phing
    fi
elif  [[ $1 = "component" ]]; then
    echo "Make the component"
    ./make_component.sh
elif  [[ $1 = "test" ]]; then
	
    ./make_component.sh
    echo "Made the component before testing."
	cd joomla-cms
	echo " Going testing..."
	if  [[ $2 = "reports" ]]; then
		libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/reports 
	elif  [[ $2 = "storage" ]]; then
		libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/storage
	elif  [[ $2 ]]; then
		libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/$2
	else
		libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/com_mymuse
		#libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/reports
		#libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/storage
	fi

elif  [[ $1 = "all" ]]; then
	./make_component.sh
	cd joomla-cms
	libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/com_mymuse
	#libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/reports
	#libraries/vendor/bin/codecept --steps run acceptance tests/Codeception/acceptance/storage
else
	echo "What no options? webdriver, phing, phing watch, component or test [sub-test] or test reports"
	echo "sub-tests: AdminLoginCest, MyMuseBasicCest, MyMuseEeStockCest, MyMuseGgShippingCest, "
	echo "MyMuseJjFormatCest, MyMuseModuleCest, MyMuseOtherViewsCest, MyMuseUninstallCest"
fi